    "scaling_source": "Tier-1 nside=128 healpix_port/outputs_iberia/dataGLMM_extinction.parquet z-score constants (mean + ddof=1 SD per raw column; cross-checked against the saved sc_ columns to <= 1e-6)",
    "scaling_constants": {
      "sampling": {
        "mean": 70.87820434570312,
        "sd": 75.77880859375,
        "max_check_diff": 0.0
      },
